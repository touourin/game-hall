# macOS and IDE files
.DS_Store
.idea/
.vscode/

# Environment variables and local secrets
.env
.env.*
!.env.example

# Python artifacts
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.data/

# Node.js and Vue artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/src/generated/communityGameModules.ts
coverage/
