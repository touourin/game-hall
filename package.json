{
  "name": "avalon-lan",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c magenta,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": ".venv/bin/uvicorn backend.app.main:app --reload --host 0.0.0.0 --port 8800",
    "dev:web": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "build": "npm --prefix frontend run build",
    "test": ".venv/bin/pytest backend/tests && npm --prefix frontend run test:run",
    "smoke": "node frontend/scripts/smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
