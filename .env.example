# Signs the browser's internal transport session; set a random production value.
GAME_HALL_SIGNING_SECRET=change-me-signing-secret
GAME_HALL_PORT=10618
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
TZ=Asia/Shanghai
MYSQL_DATABASE=game_hall
MYSQL_USER=game_hall
MYSQL_PASSWORD=change-me-app-password
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PUBLISH_HOST=127.0.0.1
MYSQL_PUBLISH_PORT=1025
REDIS_PASSWORD=change-me-redis-password
REDIS_PUBLISH_HOST=127.0.0.1
REDIS_PUBLISH_PORT=7878
PIP_INDEX_URL=https://pypi.org/simple
PYTORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
PIKAFISH_THREADS=1
PIKAFISH_HASH_MB=64
INSTALL_DOUZERO_AI=0
DOUZERO_THREADS=1
DOUZERO_BID_SAMPLES=32

# QQ SMTP transactional email. SMTP_PASS is the authorization code generated
# in QQ Mail, not the QQ account password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orangeplay@qq.com
SMTP_PASS=
SMTP_FROM_NAME="Orange Play"
SMTP_TIMEOUT_SECONDS=12
EMAIL_ACCOUNT_DAILY_LIMIT=3
EMAIL_SERVER_DAILY_LIMIT=20
EMAIL_SEND_COOLDOWN_SECONDS=60
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
