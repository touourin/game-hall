# Required secrets. Set each one to a different random value before starting
# Docker Compose; empty required values are rejected by compose.yaml.
GAME_HALL_SIGNING_SECRET=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# General application settings.
GAME_HALL_PORT=10618
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
TZ=Asia/Shanghai

# MySQL settings.
MYSQL_DATABASE=game_hall
MYSQL_USER=game_hall
MYSQL_PUBLISH_HOST=127.0.0.1
MYSQL_PUBLISH_PORT=1025

# Redis settings.
REDIS_PUBLISH_HOST=127.0.0.1
REDIS_PUBLISH_PORT=7878

# Package sources and optional AI engines. Set an engine to 0 to omit it.
PIP_INDEX_URL=https://pypi.org/simple
PYTORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
ENABLE_PIKAFISH_AI=1
ENABLE_KATAGO_AI=1
ENABLE_DOUZERO_AI=1
PIKAFISH_THREADS=1
PIKAFISH_HASH_MB=64
DOUZERO_THREADS=1
DOUZERO_BID_SAMPLES=32

# Optional QQ SMTP transactional email. Leave SMTP_USER and SMTP_PASS empty to
# disable email delivery. SMTP_PASS is the QQ Mail authorization code, not the
# QQ account password; SMTP_FROM_EMAIL defaults to SMTP_USER when left empty.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Orange Play"
SMTP_FROM_EMAIL=
SMTP_TIMEOUT_SECONDS=12
EMAIL_ACCOUNT_DAILY_LIMIT=3
EMAIL_SERVER_DAILY_LIMIT=20
EMAIL_SEND_COOLDOWN_SECONDS=60
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
